#!/usr/bin/env bash
set -eu

start_marker="# chezmoi: start zsh fallback"
end_marker="# chezmoi: end zsh fallback"
current="$(mktemp)"
trap 'rm -f "$current"' EXIT
cat >"$current"

print_fallback() {
    cat <<'EOF'
# chezmoi: start zsh fallback
# Use zsh for interactive logins when chsh is unavailable.
case $- in
    *i*)
        if zsh_path="$(command -v zsh 2>/dev/null)"; then
            # zsh preserves SHELL, so update it for programs that launch $SHELL.
            export SHELL="$zsh_path"
            exec "$SHELL" -l
        fi
        ;;
esac
# chezmoi: end zsh fallback
EOF
}

if grep -Fqx "$start_marker" "$current"; then
    in_fallback=false
    fallback_printed=false
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == "$start_marker" ]]; then
            if [[ $fallback_printed == false ]]; then
                print_fallback
                fallback_printed=true
            fi
            in_fallback=true
        elif [[ $in_fallback == true && $line == "$end_marker" ]]; then
            in_fallback=false
        elif [[ $in_fallback == false ]]; then
            printf '%s\n' "$line"
        fi
    done <"$current"
    exit 0
fi

cat "$current"
[[ ! -s $current ]] || printf '\n'
print_fallback
