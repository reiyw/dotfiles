{
  "extends": [
    "github>aquaproj/aqua-renovate-config#2.13.0",
    ":automergeMinor",
    ":automergeRequireAllStatusChecks",
    "schedule:weekends"
  ],
  "timezone": "Asia/Tokyo",
  "packageRules": [
    {
      "description": "Keep tree-sitter on binaries compatible with pre-GLIBC 2.39 hosts",
      "matchPackageNames": [
        "tree-sitter/tree-sitter"
      ],
      "allowedVersions": "<0.26.0"
    },
    {
      "description": "Avoid freshly published npm releases",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "pnpm global packages pinned in chezmoi run_onchange script",
      "managerFilePatterns": [
        "/^run_onchange_after_01-install-pnpm-global-packages\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>@?[^\\s@=]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
