#!/usr/bin/env bash
{{ if eq .chezmoi.os "linux" -}}
run_with_sudo () {
    if [[ $EUID = 0 ]]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        command sudo "$@"
    else
        echo "Skipping (sudo unavailable): $*" >&2
        return 0
    fi
}

run_with_sudo apt-get update
run_with_sudo apt-get install -y unzip wget
{{ end -}}
