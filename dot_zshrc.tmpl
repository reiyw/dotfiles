#
# Options
#

# Directories: `dir` alone cds into it; cd pushes onto the directory stack.
setopt AUTO_CD AUTO_PUSHD CD_SILENT PUSHD_IGNORE_DUPS PUSHD_SILENT PUSHD_TO_HOME

# Globbing: match dotfiles, ignore case, and behave like bash by passing
# unmatched patterns through literally instead of erroring (e.g.
# `npm i foo@^1.0`, `git show HEAD^`). EXTENDED_GLOB stays off for the same reason.
setopt GLOBDOTS NO_CASE_GLOB NO_NOMATCH

# Jobs and misc.
setopt INTERACTIVE_COMMENTS NO_CLOBBER LONG_LIST_JOBS NO_BG_NICE NO_CHECK_JOBS NO_HUP

#
# History
#

HISTFILE=~/.zsh_history
HISTSIZE=1000000000
SAVEHIST=$HISTSIZE
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS HIST_IGNORE_SPACE HIST_VERIFY SHARE_HISTORY

#
# Environment
#

{{ if eq .chezmoi.os "linux" -}}
export LC_ALL=C.UTF-8
{{ else if eq .chezmoi.os "darwin" -}}
export LANG=C
export LC_CTYPE=en_US.UTF-8
{{- end }}

# CLI tools installed by these dotfiles (shared with bash, ~/.profile and systemd).
{{ includeTemplate "cli-env" "sh" }}

# Tell the location of the terminfo database to the python-build-standalone Python.
# https://gregoryszorc.com/docs/python-build-standalone/main/quirks.html#backspace-key-doesn-t-work-in-python-repl
export TERMINFO_DIRS=/etc/terminfo:/lib/terminfo:/usr/share/terminfo

#
# Completion
#

ZSH_PLUGINS=~/.local/share/zsh/plugins

# compinit must run after every fpath addition. ~/.zshenv sets
# skip_global_compinit so that /etc/zsh/zshrc doesn't run it first.
fpath=($ZSH_PLUGINS/zsh-completions/src $fpath)
autoload -Uz compinit
# compinit's security audit takes most of the startup time, so trust the dump
# and rebuild it only when a directory in fpath has gained or lost a file.
() {
  local dump=~/.zcompdump dir
  for dir in $fpath; do
    if [[ $dir -nt $dump ]]; then
      compinit -d $dump && touch $dump
      return
    fi
  done
  compinit -C -d $dump
}

setopt ALWAYS_TO_END COMPLETE_IN_WORD NO_LIST_BEEP
zstyle ':completion::complete:*' use-cache on
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{[:lower:]}={[:upper:]}' '+r:|[._-]=* r:|=*' '+l:|=*'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes
zstyle ':completion:*' squeeze-slashes true
zstyle ':completion:*:options' description yes
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches found --%f'
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:functions' ignored-patterns '(_*|pre(cmd|exec)|prompt_*)'
zstyle ':completion:*:(rm|kill|diff):*' ignore-line other

#
# Line editor
#

bindkey -e

# Remove path separator from WORDCHARS.
WORDCHARS=${WORDCHARS//[\/]}

bindkey '^[[H' beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[Z' reverse-menu-complete
bindkey ' ' magic-space

autoload -Uz edit-command-line && zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Quote URLs as they are typed or pasted.
autoload -Uz bracketed-paste-url-magic && zle -N bracketed-paste bracketed-paste-url-magic
autoload -Uz url-quote-magic && zle -N self-insert url-quote-magic

source ~/.local/zsh-keybindings.zsh

#
# fzf
#

export FZF_DEFAULT_COMMAND='fd -H --no-ignore-vcs -E .git -td -tf'
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
export FZF_ALT_C_COMMAND='fd -H --no-ignore-vcs -E .git -td'
export FZF_CTRL_T_OPTS="--bind ctrl-/:toggle-preview --preview 'if [[ -d {} ]]; then lsd -1F --group-directories-first --color=always -- {}; else bat --color=always --line-range :500 -- {}; fi'"
export FZF_ALT_C_OPTS="--bind ctrl-/:toggle-preview --preview 'lsd -1F --group-directories-first --color=always -- {}'"
_fzf_compgen_path() { fd -H --no-ignore-vcs -E .git -td -tf . "$1" }
_fzf_compgen_dir() { fd -H --no-ignore-vcs -E .git -td . "$1" }

source ~/.local/fzf/completion.zsh 2> /dev/null
source ~/.local/fzf/key-bindings.zsh

#
# Aliases
#

alias b=bat
alias ls='lsd'
alias l='ls -la'
alias la='ls -a'
alias lt='ls --tree'

#
# Local overrides
#

[ -f ~/.zshrc.local ] && source ~/.zshrc.local

[ -f "$HOME/.rye/env" ] && source "$HOME/.rye/env"

#
# Plugins (fetched by .chezmoiexternal.toml)
#
# The order matters: syntax highlighting wraps the widgets that exist when it
# is sourced, history-substring-search must come after it, and autosuggestions
# goes last.

source $ZSH_PLUGINS/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

source $ZSH_PLUGINS/zsh-history-substring-search/zsh-history-substring-search.zsh
for key ('^[[A' '^[OA' '^P') bindkey $key history-substring-search-up
for key ('^[[B' '^[OB' '^N') bindkey $key history-substring-search-down
unset key

ZSH_AUTOSUGGEST_MANUAL_REBIND=1
source $ZSH_PLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh

eval "$(starship init zsh)"
